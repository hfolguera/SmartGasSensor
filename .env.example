MQTT_ENABLED=true
MQTT_HOST=192.168.1.216
MQTT_PORT=1883
MQTT_USERNAME=mosquitto
MQTT_PASSWORD=CHANGE_ME
MQTT_TOPIC=home/gas/telemetry
# Diferent del client ID de l'ESP i de qualsevol altra instal·lacio d'aquesta app.
MQTT_CLIENT_ID=smartgassensor-production
MQTT_TLS=false
# MQTT_CA_FILE=/certs/ca.crt
DB_PATH=/data/smartgas.db
TANK_CONFIG_PATH=/config/tanks.json
STALE_AFTER_SECONDS=10800
RETENTION_DAYS=3650
# Buit: calcula només des de l’activació de la funció. Per reutilitzar dades fiables:
# CONSUMPTION_SINCE=2026-11-09T00:00:00+01:00
CONSUMPTION_SINCE=
CONSUMPTION_NOISE_LITERS=5
CONSUMPTION_REFILL_LITERS=50
CONSUMPTION_MAX_GAP_SECONDS=10800
# Opcional: token per /api/v1 i /metrics (web, HA i scripts).
API_TOKEN=

# Notificacions ntfy
NTFY_ENABLED=true
NTFY_SERVER_URL=https://ntfy.calfolguera.freemyip.com
NTFY_TOPIC=home-notifications
NTFY_HYSTERESIS_PERCENT=5
PUBLIC_WEB_URL=https://smartgassensor.calfolguera.freemyip.com
NTFY_TOKEN=
# Autenticació amb usuari i contrasenya. Deixa NTFY_TOKEN buit per utilitzar-la.
NTFY_USERNAME=
NTFY_PASSWORD=
